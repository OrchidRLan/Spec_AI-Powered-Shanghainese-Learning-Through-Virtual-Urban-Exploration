# Copy to .env. Never commit credentials.
DASHSCOPE_API_KEY=
SPEECH_ENABLE_LIVE=false
QWEN_ASR_REGION=beijing
QWEN_TTS_REGION=beijing
QWEN_LLM_REGION=beijing
QWEN_LLM_MODEL=qwen-plus
QWEN_LLM_JSON_MODE=json_object
# Optional overrides: QWEN_ASR_API_KEY, QWEN_TTS_API_KEY, QWEN_LLM_API_KEY
# Optional per-service switches: QWEN_ASR_ENABLE_LIVE, QWEN_TTS_ENABLE_LIVE, QWEN_LLM_ENABLE_LIVE

# Enable only after a deliberate live smoke check.
QWEN_ASR_ENABLE_LIVE=false

# ASR provider: qwen (default) or openai_compatible (local / self-hosted /v1/audio/transcriptions).
# No fallback between providers. Plain http is allowed only for loopback, never with APP_ENV=production.
ASR_PROVIDER=qwen
# LOCAL_ASR_ENDPOINT=http://127.0.0.1:8000
# LOCAL_ASR_MODEL=
# LOCAL_ASR_LANGUAGE=        # optional hint passed through, e.g. zh
# LOCAL_ASR_API_KEY=         # optional
# LOCAL_ASR_TIMEOUT_SECONDS=12
LOCAL_ASR_ENABLE_LIVE=false

# Offline TTS provider for scripts/speech.py tts-generate: qwen (default, Jada) or openai_compatible
# (/v1/audio/speech). Generated audio is always pending listening review. Review-round scripts stay on Qwen.
TTS_PROVIDER=qwen
# LOCAL_TTS_ENDPOINT=http://127.0.0.1:8000
# LOCAL_TTS_MODEL=
# LOCAL_TTS_VOICE=
# LOCAL_TTS_LANGUAGE=
# LOCAL_TTS_API_KEY=
# LOCAL_TTS_TIMEOUT_SECONDS=60
LOCAL_TTS_ENABLE_LIVE=false
TEXT_INTERPRETER=development_parser

# Local defaults. Production setup: docs/engineering/Deployment.md
APP_ENV=development
COOKIE_SECURE=false
# Production requires an absolute path on a persistent disk, e.g. /var/data/app.db.
# DATABASE_PATH=
# ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app
# BACKEND_PROXY_SECRET=  # Same server-only random value on Vercel and Render (32+ characters).
# BACKEND_URL=           # Vercel function only: the actual HTTPS Render service origin.
