{
  "name": "yuyuan-shanghainese",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/validate-content.mjs && vite build",
    "build:release": "node scripts/validate-content.mjs --production && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "content:check": "node scripts/validate-content.mjs",
    "test:api": "backend/.venv/bin/python -m pytest backend/tests -q",
    "test:content": "node --test content/validate-content.test.mjs",
    "check": "npm run typecheck && npm run test:content && npm run test:ui && npm run test:api && npm run audio:check",
    "test:ui": "node --experimental-strip-types --test frontend/tests/*.test.mjs",
    "audio:check": "backend/.venv/bin/python scripts/speech-review.py check && node scripts/check-audio-r3.mjs && backend/.venv/bin/python scripts/speech-review-r4.py check"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
